    <string name="feature_guide_record_contact_title">Choose a contact first</string>
    <string name="feature_guide_record_contact_body">Choose an existing contact or tap Add Contact. After saving, you will return to this form with the new contact selected.</string>
    <string name="feature_guide_record_amount_title">Enter the gift amount</string>
    <string name="feature_guide_record_amount_body">Enter the amount and choose the actual date. Your information stays on this device.</string>
    <string name="feature_guide_record_direction_title">Received or given</string>
    <string name="feature_guide_record_direction_body">Choose Received for money you received and Given for money you gave. Then choose an occasion or add a note.</string>
