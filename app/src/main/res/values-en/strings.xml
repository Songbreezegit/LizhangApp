    <string name="feature_guide_calendar_body">Dates with records have a mark. Change the month and tap a date to see the gifts received or given that day.</string>
    <string name="feature_guide_search_title">Find a record quickly</string>
    <string name="feature_guide_search_body">Search by contact name, phone number, or notes. Tap a result to view its details.</string>
    <string name="feature_guide_statistics_title">Review a year of gifts</string>
